{
  parserClass="org.mvnsearch.jetbrains.commandline.parser.AmberCommandParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="AmberCommand"
  psiImplClassSuffix="Impl"
  psiPackage="org.mvnsearch.jetbrains.commandline.psi"
  psiImplPackage="org.mvnsearch.jetbrains.commandline.psi.impl"

  elementTypeHolderClass="org.mvnsearch.jetbrains.commandline.psi.AmberCommandTypes"
  elementTypeClass="org.mvnsearch.jetbrains.commandline.psi.AmberCommandElementType"
  tokenTypeClass="org.mvnsearch.jetbrains.commandline.psi.AmberCommandTokenType"

  tokens = [
    AMP_AMP      = '&&'
    PIPE_PIPE    = '||'
    GT_GT        = '>>'
    PIPE         = '|'
    PIPE_ERR     = '|&'
    GT           = '>'
    LT           = '<'
    AMP          = '&'
    SEMICOLON    = ';'

    DASH_DASH    = '--'
    DASH         = '-'
    EQ           = '='
    COLON        = ':'
    DOLLAR       = '$'

    LBRACE       = '{'
    RBRACE       = '}'
    OPEN_BRACKET2 = '[['
    CLOSE_BRACKET2 = ']]'
    OPEN_PAREN2 = '(('
    CLOSE_PAREN2 = '))'

    REDIRECT_ERR   = 'regexp:("2>")|("2>>")|("&>")|("&>>")|("2>&1")|("|&")'
    VARIABLE   = 'regexp:[A-Za-z_][A-Za-z0-9_]*'
    LONG_OPTION   = 'regexp:("--")[A-Za-z_][A-Za-z0-9_-]*'
    SHORT_OPTION   = 'regexp:("-")[A-Za-z_][A-Za-z0-9_-]*'
    // a path / file name: may contain '-' but not start with one (so leading '-'/'--' stays an option dash)
    WORD         = 'regexp:([^ \t\f\r\n|<>&;{}"\x27#=:-]|\\.)([^ \t\f\r\n|<>&;{}"\x27#=:]|\\.)*'
    // a glob pattern: a filename-like run containing a wildcard '*', '?' or a '[...]' bracket expression
    GLOB         = 'regexp:([^ \t\f\r\n|<>&;{}"\x27#=:*?\[\]-]|\\.|[*?]|\[[^\]\r\n]*\])*[*?\[]([^ \t\f\r\n|<>&;{}"\x27#=:]|\[[^\]\r\n]*\])*'
    DQ_STRING    = 'regexp:"([^\\"]|\\.)*"?'
    SQ_STRING    = "regexp:'[^']*'?"

    COMMENT      = 'regexp:#[^\r\n]*'
    NEWLINE      = 'regexp:(\r\n|\r|\n)+'
  ]
}

// A script is a list of command lines, separated by '&', &&', '||', ';' or newlines.
root ::= (command_line (cmd_separator+ command_line)*)? cmd_separator*

private cmd_separator ::= NEWLINE | SEMICOLON | AMP_AMP | AMP | PIPE_PIPE

// command_line ::= one or more commands joined by '|' or '|&'
private pipe_op ::= PIPE | PIPE_ERR
command_line ::= command (pipe_op command)*

// command ::= a command name followed by options, arguments and redirections (any order)
command ::= command_name command_element*

private command_element ::= redirection | option | DASH_DASH | argument

command_name ::= interpolation | WORD

// options: long ('--name', '--name=value', '--') and short ('-x', '-')
option ::= long_option_pair | short_option_pair
long_option_pair ::= LONG_OPTION '='? assignment?
short_option_pair ::= SHORT_OPTION '='? assignment?
assignment ::=  value

argument ::= value

// I/O redirections: > >> <
redirection ::= redirect_op redirect_target
private redirect_op ::= GT_GT | GT | LT | REDIRECT_ERR
redirect_target ::=  value

// a value is one or more parts joined by ':' or '=' (e.g. host:port, key=value, image:tag)
private value ::= value_part (value_glue value_part)*
private value_glue ::= COLON | EQ
private value_part ::= interpolation | string_literal  | WORD | DASH | OPEN_BRACKET2 | CLOSE_BRACKET2 | OPEN_PAREN2 | CLOSE_PAREN2 | glob_pattern

// a glob pattern such as *.txt, file?.log or src/[abc]*.kt
glob_pattern ::= GLOB

string_literal ::= DQ_STRING | SQ_STRING

// {name} interpolated variable
interpolation ::=  DOLLAR? '{' VARIABLE '}'
